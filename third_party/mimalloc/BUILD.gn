import("../../config.gni")

config("mimalloc_public_config") {
  include_dirs = [ "mimalloc/include" ]
}

config("mimalloc_private_config") {
  # MI_MALLOC_OVERRIDE is what makes alloc-override.c emit the strong `malloc`
  # / `free` / `operator new` symbols that shadow glibc's (weak) ones — without
  # it, static.c only produces the prefixed `mi_malloc` API and nothing is
  # overridden. mimalloc's own CMake sets this on the object target
  # (target_compile_definitions(mimalloc-obj PRIVATE MI_MALLOC_OVERRIDE)); we
  # mirror it here since we compile static.c directly.
  defines = [ "MI_MALLOC_OVERRIDE=1" ]

  # mimalloc builds the whole allocator from a single amalgamation unit
  # (src/static.c #includes the other src/*.c). It is third-party code, so
  # silence its warnings instead of patching them.
  #
  # -Wno-typedef-redefinition: mimalloc targets C11, which allows repeating an
  # identical typedef; the toolchain compiles .c files as -std=c99 (see
  # build/config/compiler/BUILD.gn), where that trips -Wtypedef-redefinition and
  # -Werror. Suppressing it matches the existing precedent in
  # patches/vulkan-loader (same warning, same fix).
  cflags = [
    "-Wno-typedef-redefinition",
    "-Wno-unused-function",
    "-Wno-unused-variable",
    "-Wno-unknown-pragmas",
    "-Wno-unused-but-set-variable",
  ]
}

# A source_set (not a static_library) so every object is linked unconditionally
# into the final executable. That matters for an allocator override: the strong
# malloc/free symbols mimalloc defines must be present in the link, otherwise the
# linker could drop them and glibc's (weak) symbols would win.
source_set("mimalloc") {
  public_configs = [ ":mimalloc_public_config" ]
  configs += [ ":mimalloc_private_config" ]
  sources = [ "mimalloc/src/static.c" ]
}
